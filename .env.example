# PostgreSQL
DATABASE_URL=postgresql+psycopg://adrobot:adrobot@db:5432/adrobot

# Adrobot training stand: host only, without /admin_api/v1
KEITARO_BASE_URL=https://keitaro-for-tests.etolegko.com
KEITARO_API_KEY=PASTE_YOUR_API_KEY_HERE

# Read-only reference entities already provisioned on the stand
KEITARO_DEFAULT_DOMAIN_ID=1813
KEITARO_DEFAULT_GROUP_ID=10332
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=836

# GEO matched traffic is sent to Google
GOOGLE_REDIRECT_URL=https://google.com

# Set true only for local development when you want tables created automatically.
AUTO_CREATE_TABLES=false
